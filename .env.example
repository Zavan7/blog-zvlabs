# Copie para .env e preencha. O .env nunca vai para o Git.

# Gere com: uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, com HTTPS: https://blog.seudominio.com.br
CSRF_TRUSTED_ORIGINS=

# Endereço público do blog, usado nos links dos e-mails (sem barra no fim)
SITE_URL=http://127.0.0.1:8000

# Portfólio ZV Labs (Maestro), usado no menu e no rodapé; vazio esconde os links
PORTFOLIO_URL=

# OAuth 2.0: credenciais criadas no Google Cloud Console e no GitHub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-mail: "console" mostra no terminal; "smtp" envia de verdade
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Blog ZV Labs <nao-responda@localhost>

# Produção
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
